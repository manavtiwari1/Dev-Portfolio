{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/manav3d.html"
    },
    {
      "source": "/manav",
      "destination": "/manav3d.html"
    },
    {
      "source": "/index",
      "destination": "/manav3d.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/about*",
      "destination": "#about"
    },
    {
      "source": "/projects*",
      "destination": "#projects"
    },
    {
      "source": "/contact*",
      "destination": "#contact"
    },
    {
      "source": "/skills*",
      "destination": "#skills"
    },
    {
      "source": "/qualifications*",
      "destination": "#qualifications"
    },
    {
      "source": "/certifications*",
      "destination": "#certifications"
    },
    {
      "source": "/home*",
      "destination": "#home"
    }
  ]
}
