{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/manav3d.html"
    },
    {
      "source": "/manav",
      "destination": "/manav3d.html"
    },
    {
      "source": "/index",
      "destination": "/manav3d.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
